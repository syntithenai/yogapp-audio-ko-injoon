  "chunks": [
    {
      "index": 0,
      "text": "환영합니다.",
      "file": "c000.ogg",
      "durationSec": 3.744
    },
    {
      "index": 1,
      "text": "도착할 시간을 가지세요.",
      "file": "c001.ogg",
      "durationSec": 5.208
    },
    {
      "index": 2,
      "text": "지지가 되는 자세로 앉거나 누우세요.",
      "file": "c002.ogg",
      "durationSec": 6.456
    },
    {
      "index": 3,
      "text": "안전하다고 느껴진다면 눈을 감으세요.",
      "file": "c003.ogg",
      "durationSec": 7.08
    },
    {
      "index": 4,
      "text": "지면과의 접촉을 느껴보세요.",
      "file": "c004.ogg",
      "durationSec": 5.832
    },
    {
      "index": 5,
      "text": "천천히 숨을 들이마십니다.",
      "file": "c005.ogg",
      "durationSec": 5.52
    },
    {
      "index": 6,
      "text": "더 길게 숨을 내쉬세요.",
      "file": "c006.ogg",
      "durationSec": 5.376
    },
    {
      "index": 7,
      "text": "[일시정지:23]",
      "file": "c007.ogg",
      "durationSec": 5.592
    },
    {
      "index": 8,
      "text": "다시 한번.",
      "file": "c008.ogg",
      "durationSec": 3.888
    },
    {
      "index": 9,
      "text": "[일시정지:23]",
      "file": "c009.ogg",
      "durationSec": 5.592
    },
    {
      "index": 10,
      "text": "어깨를 내리세요.",
      "file": "c010.ogg",
      "durationSec": 4.56
    },
    {
      "index": 11,
      "text": "배를 부드럽게 풀어주세요.",
      "file": "c011.ogg",
      "durationSec": 5.448
    },
    {
      "index": 12,
      "text": "[일시정지:29]",
      "file": "c012.ogg",
      "durationSec": 5.616
    },
    {
      "index": 13,
      "text": "귀를 열어주세요.",
      "file": "c013.ogg",
      "durationSec": 4.632
    },
    {
      "index": 14,
      "text": "가장 가까운 소리를 알아차리세요.",
      "file": "c014.ogg",
      "durationSec": 6.288
    },
    {
      "index": 15,
      "text": "[일시정지:29]",
      "file": "c015.ogg",
      "durationSec": 5.616
    },
    {
      "index": 16,
      "text": "가장 멀리 들리는 소리를 알아차리세요.",
      "file": "c016.ogg",
      "durationSec": 6.768
    },
    {
      "index": 17,
      "text": "[일시정지:29]",
      "file": "c017.ogg",
      "durationSec": 5.616
    },
    {
      "index": 18,
      "text": "소리 사이의 침묵을 알아차리세요.",
      "file": "c018.ogg",
      "durationSec": 6.192
    },
    {
      "index": 19,
      "text": "[일시정지:35]",
      "file": "c019.ogg",
      "durationSec": 5.664
    },
    {
      "index": 20,
      "text": "소리가 생기고 사라집니다. 이름을 붙일 필요 없습니다.",
      "file": "c020.ogg",
      "durationSec": 10.872
    },
    {
      "index": 21,
      "text": "청각이 듣습니다.",
      "file": "c021.ogg",
      "durationSec": 4.464
    },
    {
      "index": 22,
      "text": "[일시정지:47]",
      "file": "c022.ogg",
      "durationSec": 6.12
    },
    {
      "index": 23,
      "text": "마음이 흐트러지면, 다시 청각으로 돌아가세요.",
      "file": "c023.ogg",
      "durationSec": 8.232
    },
    {
      "index": 24,
      "text": "[일시정지:35]",
      "file": "c024.ogg",
      "durationSec": 5.664
    },
    {
      "index": 25,
      "text": "자신의 숨소리도 포함하세요.",
      "file": "c025.ogg",
      "durationSec": 5.736
    },
    {
      "index": 26,
      "text": "[일시정지:35]",
      "file": "c026.ogg",
      "durationSec": 5.664
    },
    {
      "index": 27,
      "text": "전체 음경을 안고 편안히 쉬세요.",
      "file": "c027.ogg",
      "durationSec": 6.264
    },
    {
      "index": 28,
      "text": "생명의 진동장.",
